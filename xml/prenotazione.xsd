<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="prenotazioni">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                    name="prenotazione"
                    minOccurs="0"
                    maxOccurs="unbounded">

                    <xs:complexType>

                        <xs:sequence>

                            <xs:element
                                name="id_cliente"
                                type="xs:integer"/>

                            <xs:element
                                name="id_viaggio"
                                type="xs:integer"
                                minOccurs="0"/>

                            <xs:element
                                name="destinazione"
                                type="xs:string"/>

                            <xs:element
                                name="categoria"
                                type="xs:string"/>

                            <xs:element
                                name="costo"
                                type="xs:decimal"/>

                            <xs:element
                                name="id_kyoto"
                                type="xs:integer"
                                minOccurs="0"/>

                            <xs:element
                                name="id_reykjavik"
                                type="xs:integer"
                                minOccurs="0"/>

                            <xs:element
                                name="id_losangeles"
                                type="xs:integer"
                                minOccurs="0"/>

                            <xs:element
                                name="id_bali"
                                type="xs:integer"
                                minOccurs="0"/>

                        </xs:sequence>

                        <xs:attribute
                            name="id_prenotazione"
                            type="xs:integer"
                            use="required"/>

                    </xs:complexType>

                </xs:element>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>