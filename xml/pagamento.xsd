<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="pagamenti">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                    name="pagamento"
                    minOccurs="0"
                    maxOccurs="unbounded">

                    <xs:complexType>

                        <xs:sequence>

                            <xs:element
                                name="data"
                                type="xs:date"/>

                            <xs:element
                                name="importo"
                                type="xs:decimal"/>

                            <xs:element
                                name="esito"
                                type="xs:string"/>

                            <xs:element
                                name="id_cliente"
                                type="xs:integer"/>

                        </xs:sequence>

                        <xs:attribute
                            name="id_pagamento"
                            type="xs:integer"
                            use="required"/>

                    </xs:complexType>

                </xs:element>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>