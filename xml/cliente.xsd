<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="clienti">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                    name="cliente"
                    maxOccurs="unbounded">

                    <xs:complexType>

                        <xs:sequence>

                            <xs:element
                                name="cf"
                                type="xs:string"/>

                            <xs:element
                                name="nome"
                                type="xs:string"/>

                            <xs:element
                                name="cognome"
                                type="xs:string"/>

                            <xs:element
                                name="data_nascita"
                                type="xs:date"/>

                            <xs:element
                                name="telefono"
                                type="xs:string"/>

                            <xs:element
                                name="email"
                                type="xs:string"/>

                        </xs:sequence>

                        <xs:attribute
                            name="id_cliente"
                            type="xs:integer"
                            use="required"/>

                    </xs:complexType>

                </xs:element>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>